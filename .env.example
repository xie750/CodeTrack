CODETRACK_DATABASE_URL=postgresql+psycopg2://codetrack:codetrack@localhost:5432/codetrack
CODETRACK_DEMO_USER_ID=user_student_001
CODETRACK_SANDBOX_TIMEOUT_SECONDS=3
# Piston API base URL. Local WSL usually works with http://127.0.0.1:2000.
CODETRACK_PISTON_BASE_URL=
# Legacy CodeTrack sandbox service. Keep empty when using Piston for new runner profiles.
CODETRACK_SANDBOX_SERVICE_URL=http://sandbox:8011
# 留空=用 PATH 上的 g++；Windows + Git Bash 下需填绝对路径，例如
# CODETRACK_CXX=D:\msys64\ucrt64\bin\g++.exe
CODETRACK_CXX=
CODETRACK_MODEL_GATEWAY_URL=
CODETRACK_MODEL_API_KEY=
CODETRACK_MODEL_API_BASE_URL=https://api.openai.com/v1
CODETRACK_MODEL_NAME=

# Optional second model shown in the student AI tutor switcher.
# Leave blank to keep the "微调模型" option visible but disabled.
CODETRACK_FINE_TUNED_MODEL_API_KEY=
CODETRACK_FINE_TUNED_MODEL_API_BASE_URL=http://codetrack-model:8080/v1
CODETRACK_FINE_TUNED_MODEL_NAME=/models/codetrack-q4_k_m.gguf
CODETRACK_FINE_TUNED_MODEL_LABEL=CodeTrack 微调模型
CODETRACK_API_PREFIX=/api/v1

# PPT renderer route:
# auto = Presenton when configured, otherwise local python-pptx fallback.
# presenton = try Presenton first; ppt_master = try PPT Master wrapper command; local = force local fallback.
CODETRACK_PPT_RENDERER=auto

# Optional external PPT renderer. Leave disabled to use the local PPTX fallback.
CODETRACK_PRESENTON_ENABLED=false
CODETRACK_PRESENTON_BASE_URL=http://127.0.0.1:5001
# Browser-facing Presenton URL. Leave empty to reuse CODETRACK_PRESENTON_BASE_URL.
CODETRACK_PRESENTON_PUBLIC_BASE_URL=http://127.0.0.1:5001
# Use the API key generated in Presenton when auth is enabled.
CODETRACK_PRESENTON_API_KEY=
# bearer works for Presenton API keys; use basic when your deployment expects Basic auth.
CODETRACK_PRESENTON_AUTH_TYPE=bearer
CODETRACK_PRESENTON_USERNAME=
CODETRACK_PRESENTON_PASSWORD=
# Optional template name/id configured in Presenton.
CODETRACK_PRESENTON_TEMPLATE=
CODETRACK_PRESENTON_LANGUAGE=Chinese
CODETRACK_PRESENTON_SLIDE_COUNT=6
CODETRACK_PRESENTON_TIMEOUT_SECONDS=180

# Optional PPT Master route. PPT Master is an agent skill/workflow, so CodeTrack
# calls a wrapper command instead of importing it as a library.
# The command may use placeholders: {request_json}, {output_pptx}, {workspace_dir}, {resource_id}.
# Without placeholders, CodeTrack appends: --request-json <path> --output-pptx <path>.
CODETRACK_PPT_MASTER_ENABLED=false
CODETRACK_PPT_MASTER_COMMAND="python D:/shy/CodeTrack/scripts/ppt_master_bridge.py --request-json {request_json} --output-pptx {output_pptx}"
CODETRACK_PPT_MASTER_HOME=D:/shy/CodeTrack/tools/ppt-master-main
CODETRACK_PPT_MASTER_WORKSPACE_DIR=
CODETRACK_PPT_MASTER_TIMEOUT_SECONDS=300

CODETRACK_REDIS_URL=redis://localhost:6379/0
CODETRACK_S3_ENDPOINT=http://localhost:9000
CODETRACK_S3_ACCESS_KEY=minioadmin
CODETRACK_S3_SECRET_KEY=minioadmin
CODETRACK_S3_BUCKET=codetrack-knowledge
CODETRACK_S3_SECURE=false
CODETRACK_MAX_UPLOAD_MB=100
CODETRACK_RAG_STORAGE_BACKEND=s3
CODETRACK_RAG_LOCAL_STORAGE_DIR=./var/rag-objects
CODETRACK_EMBEDDING_PROVIDER=bge_m3
CODETRACK_EMBEDDING_MODEL=BAAI/bge-m3
CODETRACK_EMBEDDING_DIM=1024
CODETRACK_EMBEDDING_BATCH_SIZE=16
CODETRACK_RERANK_PROVIDER=bge
CODETRACK_RERANK_MODEL=BAAI/bge-reranker-v2-m3
CODETRACK_PARENT_TARGET_CHARS=1800
CODETRACK_PARENT_MAX_CHARS=2600
CODETRACK_CHILD_TARGET_CHARS=450
CODETRACK_CHILD_MAX_CHARS=650
CODETRACK_CHILD_OVERLAP_CHARS=50
CODETRACK_DENSE_TOP_K=20
CODETRACK_LEXICAL_TOP_K=20
CODETRACK_RERANK_CANDIDATES=30
CODETRACK_RERANK_TOP_N=6
CODETRACK_MIN_RERANK_SCORE=0.15
CODETRACK_RRF_K=60
CODETRACK_MAX_CONTEXT_TOKENS=6000
