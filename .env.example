CODETRACK_DATABASE_URL=postgresql+psycopg2://codetrack:codetrack@localhost:5432/codetrack
CODETRACK_DEMO_USER_ID=user_student_001
CODETRACK_SANDBOX_TIMEOUT_SECONDS=3
# Piston API base URL. Local WSL usually works with http://127.0.0.1:2000.
CODETRACK_PISTON_BASE_URL=
# Legacy CodeTrack sandbox service. Keep empty when using Piston for new runner profiles.
CODETRACK_SANDBOX_SERVICE_URL=http://sandbox:8011
# 留空=用 PATH 上的 g++；Windows + Git Bash 下需填绝对路径，例如
# CODETRACK_CXX=D:\msys64\ucrt64\bin\g++.exe
CODETRACK_CXX=
CODETRACK_MODEL_GATEWAY_URL=
CODETRACK_MODEL_API_KEY=
CODETRACK_MODEL_API_BASE_URL=https://api.openai.com/v1
CODETRACK_MODEL_NAME=
CODETRACK_API_PREFIX=/api/v1
CODETRACK_REDIS_URL=redis://localhost:6379/0
CODETRACK_S3_ENDPOINT=http://localhost:9000
CODETRACK_S3_ACCESS_KEY=minioadmin
CODETRACK_S3_SECRET_KEY=minioadmin
CODETRACK_S3_BUCKET=codetrack-knowledge
CODETRACK_S3_SECURE=false
CODETRACK_MAX_UPLOAD_MB=100
CODETRACK_RAG_STORAGE_BACKEND=s3
CODETRACK_RAG_LOCAL_STORAGE_DIR=./var/rag-objects
CODETRACK_EMBEDDING_PROVIDER=bge_m3
CODETRACK_EMBEDDING_MODEL=BAAI/bge-m3
CODETRACK_EMBEDDING_DIM=1024
CODETRACK_EMBEDDING_BATCH_SIZE=16
CODETRACK_RERANK_PROVIDER=bge
CODETRACK_RERANK_MODEL=BAAI/bge-reranker-v2-m3
CODETRACK_PARENT_TARGET_CHARS=1800
CODETRACK_PARENT_MAX_CHARS=2600
CODETRACK_CHILD_TARGET_CHARS=450
CODETRACK_CHILD_MAX_CHARS=650
CODETRACK_CHILD_OVERLAP_CHARS=50
CODETRACK_DENSE_TOP_K=20
CODETRACK_LEXICAL_TOP_K=20
CODETRACK_RERANK_CANDIDATES=30
CODETRACK_RERANK_TOP_N=6
CODETRACK_MIN_RERANK_SCORE=0.15
CODETRACK_RRF_K=60
CODETRACK_MAX_CONTEXT_TOKENS=6000
