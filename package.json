{
  "name": "codetrack-unified-teaching",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --host 127.0.0.1 --port 5173",
    "dev:backend": "python -m uvicorn teacher_backend.app.main:app --host 127.0.0.1 --port 8001 --reload",
    "build": "tsc -b && vite build",
    "test:backend": "python -m pytest teacher_backend/tests -q -p no:cacheprovider",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@types/d3-force": "^3.0.10",
    "antd": "^6.1.3",
    "d3-force": "^3.0.0",
    "echarts": "6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
